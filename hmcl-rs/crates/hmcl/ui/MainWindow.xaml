<Window xmlns="https://github.com/ferroui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HMCL.RS"
        Width="960"
        Height="600">
    <Grid ColumnDefinitions="200,*">
        <Border Grid.Column="0" Background="#2B579A" Padding="12">
            <StackPanel Spacing="6">
                <TextBlock Text="HMCL" FontSize="22" Foreground="White"/>
                <TextBlock x:Name="Subtitle" Text="Hello Minecraft! Launcher" FontSize="12" Foreground="#E6EDF7"/>
                <ListBox x:Name="Sidebar" Margin="0,12,0,0">
                    <ListBoxItem x:Name="NavGames"/>
                    <ListBoxItem x:Name="NavDownload"/>
                    <ListBoxItem x:Name="NavAccounts"/>
                    <ListBoxItem x:Name="NavSettings"/>
                    <ListBoxItem x:Name="NavAbout"/>
                </ListBox>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <StackPanel x:Name="WelcomePanel" Margin="24" Spacing="8">
                <TextBlock x:Name="Welcome" Text="Welcome to HMCL" FontSize="24"/>
                <TextBlock x:Name="Description" FontSize="14" TextWrapping="Wrap"/>
                <TextBlock x:Name="Hint" FontSize="14" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- The page the user is on; it is put here by the code. -->
            <ContentControl x:Name="Content" />
        </Grid>
    </Grid>
</Window>
