<Window xmlns="https://github.com/ferroui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HMCL.RS"
        Width="960"
        Height="600">
    <Grid ColumnDefinitions="200,*">
        <Border Grid.Column="0" Background="#2B579A" Padding="12">
            <StackPanel Spacing="6">
                <TextBlock Text="HMCL.RS" FontSize="22" Foreground="White"/>
                <TextBlock Text="Hello Minecraft! Launcher" FontSize="12" Foreground="#E6EDF7"/>
                <ListBox Margin="0,12,0,0">
                    <ListBoxItem Content="游戏列表"/>
                    <ListBoxItem Content="下载"/>
                    <ListBoxItem Content="多账户"/>
                    <ListBoxItem Content="设置"/>
                    <ListBoxItem Content="关于"/>
                </ListBox>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" Margin="24" Spacing="8">
            <TextBlock Text="欢迎使用 HMCL.RS" FontSize="24"/>
            <TextBlock Text="HMCL 的 Rust 重写版本，界面由 FerroUI 的 XAML 运行时加载器构建。"
                       FontSize="14"/>
            <TextBlock Text="请在左侧选择要管理的功能。" FontSize="14" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</Window>
