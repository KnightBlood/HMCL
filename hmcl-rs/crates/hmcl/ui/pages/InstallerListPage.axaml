<UserControl xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HMCL.ViewModels"
             xmlns:game="clr-namespace:HMCL.Game"
             x:DataType="vm:MainWindowViewModel">

    <StackPanel Spacing="12">
        <TextBlock Text="{DynamicResource hmcl.installerlistpage.104_}" FontSize="16" FontWeight="Bold"/>
        <TextBlock Text="{DynamicResource hmcl.installerlistpage.106_}"
                   Foreground="{DynamicResource HMCL.MutedText}" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="InstallFromFileButton" Content="{DynamicResource hmcl.installerlistpage.108_}" Padding="16,8"/>
            <Button x:Name="InstallOptiFineButton" Content="{DynamicResource hmcl.installerlistpage.110_}" Padding="16,8"/>
            <Button x:Name="RefreshButton" Content="{DynamicResource button.refresh}" Padding="16,8"/>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource HMCL.MutedText}" VerticalAlignment="Center"/>
        </StackPanel>

        <ListBox x:Name="ComponentList" MinHeight="180">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="game:GameComponentMark">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="4">
                        <TextBlock Text="{Binding ComponentType}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Version}" Foreground="{DynamicResource HMCL.MutedText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
